# ─── Environment ─────────────────────────────────────────────────────────────
VORTEX_ENVIRONMENT=development
VORTEX_LOG_LEVEL=INFO
VORTEX_DEBUG=true

# ─── API Server ──────────────────────────────────────────────────────────────
VORTEX_API_HOST=0.0.0.0
VORTEX_API_PORT=8000

# ─── Databases ───────────────────────────────────────────────────────────────
VORTEX_DATABASE_URL=postgresql+asyncpg://vortex:vortex@localhost:5432/vortex
VORTEX_REDIS_URL=redis://localhost:6379/0

# ─── Model Providers ─────────────────────────────────────────────────────────
VORTEX_OPENAI_API_KEY=sk-...
VORTEX_ANTHROPIC_API_KEY=sk-ant-...
VORTEX_GOOGLE_API_KEY=AIza...

# ─── Auth ────────────────────────────────────────────────────────────────────
VORTEX_JWT_SECRET_KEY=dev-secret-change-in-production
