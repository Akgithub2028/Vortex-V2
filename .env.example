# ─── Environment ─────────────────────────────────────────────────────────────
VORTEX_ENVIRONMENT=development
VORTEX_LOG_LEVEL=INFO
VORTEX_DEBUG=true

# ─── API Server ──────────────────────────────────────────────────────────────
VORTEX_API_HOST=0.0.0.0
VORTEX_API_PORT=8000

# ─── Databases (Local Development) ──────────────────────────────────────────
VORTEX_DATABASE_URL=postgresql+asyncpg://vortex:vortex@localhost:5432/vortex
VORTEX_REDIS_URL=redis://localhost:6379/0

# ─── Model Providers ─────────────────────────────────────────────────────────
VORTEX_NVIDIA_API_KEY=nvapi-...
VORTEX_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
VORTEX_OPENAI_API_KEY=sk-...
VORTEX_ANTHROPIC_API_KEY=sk-ant-...
VORTEX_GOOGLE_API_KEY=AIza...

# ─── Auth ────────────────────────────────────────────────────────────────────
VORTEX_JWT_SECRET_KEY=dev-secret-change-in-production

# ──────────────────────────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT (Railway + Neon.tech + Upstash)
# Uncomment and fill in the values below for production deployment.
# ──────────────────────────────────────────────────────────────────────────────

# VORTEX_ENVIRONMENT=production
# VORTEX_LOG_LEVEL=INFO
# VORTEX_DEBUG=false

# --- Neon.tech PostgreSQL (Free Tier) ---
# Get your connection string from: https://neon.tech → Project → Connection Details
# IMPORTANT: Add +asyncpg after postgresql and ?sslmode=require at the end
# VORTEX_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Upstash Redis (Free Tier) ---
# Get your connection string from: https://upstash.com → Database → Details
# NOTE: Upstash uses rediss:// (double-s = TLS). This is correct.
# VORTEX_REDIS_URL=rediss://default:password@usw2-xxx.upstash.io:6379

# --- Auth (generate a real secret for production) ---
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# VORTEX_JWT_SECRET_KEY=<paste-generated-secret-here>

# --- CORS Origins (JSON array of allowed frontend origins) ---
# VORTEX_API_CORS_ORIGINS=["https://vortex-console.vercel.app","https://*.vercel.app"]
